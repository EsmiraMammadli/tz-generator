# Açar yoxdursa sistem heuristik rejimdə işləyir (test üçün). Real söhbət üçün ən azı birini yazın.
# Nə qədər çox provayder açarı yazsanız, 503 riski bir o qədər azalır: model 503/429/timeout verəndə
# sistem avtomatik növbəti modelə keçir. Açarı olmayan modellər atlanır.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Model sırası = prioritet (provayder/model). Adlar tez-tez dəyişir: rəsmi sənəddən yoxlayın.
# Boş buraxsanız config.py-dakı standart siyahı işləyir.
# LLM_MODELS=gemini/gemini-2.5-flash,gemini/gemini-2.5-flash-lite,groq/llama-3.3-70b-versatile,cerebras/llama-3.3-70b,mistral/mistral-small-latest
LLM_TIMEOUT=20
# Xəta verən model bu qədər saniyə atlanır (hər mesajda boş yerə gözləməmək üçün)
LLM_COOLDOWN=60
DATABASE_URL=sqlite:///./storage/app.db
RATE_LIMIT_PER_MIN=20
RETENTION_DAYS=30
# Hosting reverse proxy arxasındadırsa (Render, Fly, HF Spaces) 1 yazın, lokalda boş saxlayın
TRUST_PROXY=
# Fayllar üçün qovluq (hostinqdə diskin sıfırlanmasına görə DOCX/PDF snapshot-dan yenidən yaradılır)
# FILES_DIR=

# --- Təsdiqlənmiş TZ bildirişi (hamısı ixtiyaridir; boşdursa göndərilmir) ---
# E-poçt: NOTIFY_EMAIL (vergüllə bir neçə ünvan) + SMTP_HOST lazımdır. Gmail üçün "App password" istifadə edin.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 465 portunda SSL avtomatikdir; 587-də STARTTLS (SMTP_TLS=0 ilə söndürmək olar)
SMTP_TLS=1
# Telegram: @BotFather ilə bot yaradın, botla yazışın, chat id-ni öyrənin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Admin səhifəsi (/admin): boşdursa 404 qaytarır. Uzun təsadüfi token yazın ---
ADMIN_TOKEN=
# --- Sənəd başlığı (agentliyin adı/loqosu) ---
AGENCY_NAME=AI TZ Generatoru
AGENCY_TAGLINE=
# AGENCY_LOGO_PATH=static/agency-logo.png
AGENCY_COLOR=1E2A5E
